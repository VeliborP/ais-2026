@model WebShop.MVC.ViewModels.Order.OrderViewModel

@{
    ViewData["Title"] = "Brisanje porudžbine";
    ViewData["Subtitle"] = "Da li ste sigurni da želite da obrišete ovu porudžbinu?";
}

<div class="surface p-4 p-lg-5" style="max-width:720px;">
    <dl class="row detail-list">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderNumber)</dt>
        <dd class="col-sm-8 fw-semibold">@Model.OrderNumber</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderDate)</dt>
        <dd class="col-sm-8">@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Username)</dt>
        <dd class="col-sm-8">@Model.Username</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TotalAmount)</dt>
        <dd class="col-sm-8">@Model.TotalAmount.ToString("F")</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-8"><span class="badge rounded-pill @Model.StatusBadgeClass">@Model.StatusName</span></dd>
    </dl>

    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Otkaži</a>
    </form>
</div>
