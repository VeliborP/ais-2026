@model WebShop.MVC.ViewModels.Order.OrderViewModel

@{
    ViewData["Title"] = "Porudžbina " + Model.OrderNumber;
    ViewData["Subtitle"] = "Poručeno " + Model.OrderDate.ToString("dd.MM.yyyy u HH:mm")
        + (Model.StatusChangedAt.HasValue ? " · status promenjen " + Model.StatusChangedAt.Value.ToString("dd.MM.yyyy u HH:mm") : "");
}

@section HeaderActions {
    <span class="badge rounded-pill fs-6 px-3 py-2 align-self-center @Model.StatusBadgeClass">@Model.StatusName</span>
    @if (Model.Status == WebShop.DAL.Models.OrderStatus.Cancelled)
    {
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Obriši</a>
    }
    <a asp-action="Index" class="btn btn-light">Nazad na listu</a>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="surface overflow-hidden">
            <div class="px-4 pt-4 pb-2">
                <h2 class="h5 fw-bold mb-0">Stavke</h2>
            </div>
            <partial name="_OrderItems" model="Model" />
        </div>
    </div>
    <div class="col-lg-4 d-flex flex-column gap-4">
        <div class="surface p-4">
            <h2 class="h5 fw-bold mb-3">Promena statusa</h2>
            @if (Model.AllowedStatuses.Any())
            {
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <select name="status" class="form-select">
                        @foreach (var status in Model.AllowedStatuses)
                        {
                            <option value="@status">@WebShop.MVC.ViewModels.Order.OrderViewModel.GetStatusName(status)</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Sačuvaj</button>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">Porudžbina je u statusu „@Model.StatusName“ i status se više ne može menjati.</p>
            }
        </div>
        <div class="surface p-4">
            <h2 class="h5 fw-bold mb-3">Kupac</h2>
            <dl class="row detail-list mb-0">
                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Username)</dt>
                <dd class="col-sm-7">@Model.Username</dd>
                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Email)</dt>
                <dd class="col-sm-7 text-break">@Model.Email</dd>
            </dl>
        </div>
        <div class="surface p-4">
            <h2 class="h5 fw-bold mb-3">Podaci za dostavu</h2>
            <partial name="_ShippingDetails" model="Model" />
        </div>
    </div>
</div>
