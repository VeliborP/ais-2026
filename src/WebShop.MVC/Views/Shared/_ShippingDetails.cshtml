@model WebShop.MVC.ViewModels.Order.OrderViewModel

<dl class="row">
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FullName)</dt>
    <dd class="col-sm-8">@Model.FullName</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Address)</dt>
    <dd class="col-sm-8">@Model.Address</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.City)</dt>
    <dd class="col-sm-8">@Model.PostalCode @Model.City</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Phone)</dt>
    <dd class="col-sm-8">@Model.Phone</dd>
    @if (!string.IsNullOrEmpty(Model.Note))
    {
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Note)</dt>
        <dd class="col-sm-8">@Model.Note</dd>
    }
</dl>
