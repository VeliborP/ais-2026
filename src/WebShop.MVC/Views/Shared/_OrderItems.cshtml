@model WebShop.MVC.ViewModels.Order.OrderViewModel

<div class="table-responsive">
    <table class="table table-modern align-middle">
        <thead>
            <tr>
                <th>Šifra</th>
                <th>Proizvod</th>
                <th class="text-end">Cena</th>
                <th class="text-end">Količina</th>
                <th class="text-end">Ukupno</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><span class="badge bg-light text-dark border">@item.ProductCode</span></td>
                    <td class="fw-semibold">@item.ProductName</td>
                    <td class="text-end text-nowrap">@item.UnitPrice.ToString("F")</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end text-nowrap">@item.LineTotal.ToString("F")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Ukupno</th>
                <th class="text-end h5 fw-bold mb-0 text-nowrap">@Model.TotalAmount.ToString("F")</th>
            </tr>
        </tfoot>
    </table>
</div>
