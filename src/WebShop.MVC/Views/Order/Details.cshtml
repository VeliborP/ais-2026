@model WebShop.MVC.ViewModels.Order.OrderViewModel

@{
    ViewData["Title"] = "Order " + Model.OrderNumber;
}

<h1>Order @Model.OrderNumber</h1>

<p>
    <span class="badge @Model.StatusBadgeClass">@Model.Status</span>
    <span class="text-muted ms-2">@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</span>
</p>

<div class="row g-4">
    <div class="col-md-8">
        <h4>Items</h4>
        <hr />
        <partial name="_OrderItems" model="Model" />
    </div>
    <div class="col-md-4">
        <h4>Shipping details</h4>
        <hr />
        <partial name="_ShippingDetails" model="Model" />
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to my orders</a>
    @if (Model.CanCancel)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this order?');">
            <button type="submit" class="btn btn-outline-danger">Cancel order</button>
        </form>
    }
</div>
